// Снимает безопасный режим и защиту от опасных действий с расширений YAXUNIT и Тесты.
// Запуск: 1cv8c ENTERPRISE ... /Execute "<путь>.epf" /C"<путь к файлу протокола>"
// После записи протокола сеанс завершается сам.
// Источник: Синтакс-помощник 1С — РасширениеКонфигурации.БезопасныйРежим,
// РасширениеКонфигурации.ЗащитаОтОпасныхДействий, https://its.1c.ru/db/v8doc

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СнятьБезопасныйРежим(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура СнятьБезопасныйРежим(ПутьПротокола)

	ИменаРасширений = СтрРазделить("YAXUNIT,Тесты", ",");
	Протокол = Новый Массив;

	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если ИменаРасширений.Найти(Расширение.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		Расширение.БезопасныйРежим = Ложь;
		Расширение.ЗащитаОтОпасныхДействий = Защита;
		Расширение.Записать();
		Протокол.Добавить(СтрШаблон("%1: БезопасныйРежим=%2", Расширение.Имя, Расширение.БезопасныйРежим));
	КонецЦикла;

	Если ЗначениеЗаполнено(ПутьПротокола) Тогда
		Текст = Новый ЗаписьТекста(ПутьПротокола, КодировкаТекста.UTF8);
		Текст.Записать(СтрСоединить(Протокол, Символы.ПС));
		Текст.Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
