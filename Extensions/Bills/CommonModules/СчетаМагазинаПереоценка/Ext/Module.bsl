// Переоценка товаров через сервис объектов: POST /prices/reprice.
// Дизайн: docs/superpowers/specs/2026-11-10-repricing-design.md

#Область ПрограммныйИнтерфейс

// Новая цена товара после переоценки. К базе не обращается.
//
// Параметры:
//  СтараяЦена - Число - цена до переоценки
//  Процент - Число - процент переоценки, например 7 или -30
//
// Возвращаемое значение:
//  Число - новая цена
Функция НоваяЦена(СтараяЦена, Процент) Экспорт
	// До целых рублей, половина рубля — вверх (Окр15как20).
	Возврат Окр(СтараяЦена * (1 + Процент / 100), 0, РежимОкругления.Окр15как20);
КонецФункции

// Обработчик маршрута POST /prices/reprice.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с телом {"items": [...], "percent": ..., "date": "ГГГГ-ММ-ДД"}
//
// Возвращаемое значение:
//  HTTPСервисОтвет - 200 {"repriced": [...], "skipped": [...]} или ошибка
Функция Переоценить(Запрос) Экспорт
	Вход = ПрочитатьВход(Запрос);
	Если Вход.Ошибки.Количество() > 0 Тогда
		// Вход проверяется до чтения и записи цен: при ошибке в регистре ничего не записано.
		Возврат ОтветJSON(400, Новый Структура("error", Новый Структура("code,message,details",
			"invalid_data", "Неверные данные переоценки", Вход.Ошибки)));
	КонецЕсли;
	Попытка
		Результат = ВыполнитьПереоценку(Вход);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(Информация));
		Возврат Отказ(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	Возврат ОтветJSON(200, Результат);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает и проверяет тело запроса. Все найденные ошибки собираются сразу.
//
// Возвращаемое значение:
//  Структура:
//   * Товары - Массив из СправочникСсылка._ДемоНоменклатура - в порядке items
//   * Процент - Число
//   * Дата - Дата - дата переоценки (начало дня)
//   * Ошибки - Массив из Структура - {path, message}, см. СчетаМагазинаДанные.Ошибка
Функция ПрочитатьВход(Запрос)
	Вход = Новый Структура("Товары, Процент, Дата, Ошибки", Новый Массив, 0, Неопределено, Новый Массив);

	Тело = ТелоЗапроса(Запрос);
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, Неопределено, "Тело запроса должно быть JSON-объектом");
		Возврат Вход;
	КонецЕсли;

	ПроверитьТовары(Тело.Получить("items"), Вход);
	ПроверитьПроцент(Тело.Получить("percent"), Вход);
	ПроверитьДату(Тело.Получить("date"), Вход);
	Возврат Вход;
КонецФункции

// Тело запроса как значение JSON или Неопределено, если это не JSON.
Функция ТелоЗапроса(Запрос)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Тело = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Тело;
КонецФункции

Процедура ПроверитьТовары(Элементы, Вход)
	Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, "items", "Список товаров должен быть непустым массивом");
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		УИД = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(Элемент);
		Ссылки.Добавить(?(УИД = Неопределено, Неопределено, Справочники._ДемоНоменклатура.ПолучитьСсылку(УИД)));
	КонецЦикла;
	Свойства = СвойстваТоваров(Ссылки);

	Встреченные = Новый Соответствие;
	Для Индекс = 0 По Ссылки.ВГраница() Цикл
		Ссылка = Ссылки[Индекс];
		Свойство = ?(Ссылка = Неопределено, Неопределено, Свойства[Ссылка]);
		Если Ссылка = Неопределено Тогда
			Текст = "Неверный идентификатор товара";
		ИначеЕсли Свойство = Неопределено Тогда
			Текст = "Товар не найден";
		ИначеЕсли Свойство.ЭтоГруппа Тогда
			Текст = "Это группа, а не товар";
		ИначеЕсли Свойство.ПометкаУдаления Тогда
			Текст = "Товар помечен на удаление";
		ИначеЕсли Встреченные[Ссылка] <> Неопределено Тогда
			Текст = "Товар повторяется";
		Иначе
			Встреченные.Вставить(Ссылка, Истина);
			Вход.Товары.Добавить(Ссылка);
			Продолжить;
		КонецЕсли;
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, "items[" + Формат(Индекс, "ЧН=0; ЧГ=0") + "]", Текст);
	КонецЦикла;
КонецПроцедуры

// Соответствие ссылка -> Структура("ЭтоГруппа, ПометкаУдаления") для существующих элементов.
Функция СвойстваТоваров(Ссылки)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник._ДемоНоменклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,
			Новый Структура("ЭтоГруппа, ПометкаУдаления", Выборка.ЭтоГруппа, Выборка.ПометкаУдаления));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьПроцент(Значение, Вход)
	Допустимо = "допустимо от -50 до 100, кроме 0";
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, "percent", "Процент должен быть числом: " + Допустимо);
	ИначеЕсли Значение < -50 Или Значение > 100 Или Значение = 0 Тогда
		// Значение — как в JSON: точка, без разделителей разрядов.
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, "percent",
			"Процент " + Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0") + " недопустим: " + Допустимо);
	Иначе
		Вход.Процент = Значение;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДату(Значение, Вход)
	Дата = ДатаИзСтроки(Значение);
	Если Дата = Неопределено Тогда
		СчетаМагазинаДанные.Ошибка(Вход.Ошибки, "date", "Дата должна быть в формате ГГГГ-ММ-ДД");
	Иначе
		Вход.Дата = Дата;
	КонецЕсли;
КонецПроцедуры

// ГГГГ-ММ-ДД -> Дата или Неопределено, если строка не такая или даты не существует.
Функция ДатаИзСтроки(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 10
		Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2);
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Результат = Дата(Цифры);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	// Дата(...) может нормализовать несуществующую дату — сверяем обратным преобразованием.
	Если Формат(Результат, "ДФ=yyyy-MM-dd") <> Значение Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Переоценивает товары: старая цена — срез на конец предыдущего дня, новая — с начала дня переоценки.
// Набор записей с отбором по периоду и товару заменяет прежнюю запись: повтор дает ту же цену.
Функция ВыполнитьПереоценку(Вход)
	Результат = Новый Структура("repriced,skipped", Новый Массив, Новый Массив);
	СтарыеЦены = СтарыеЦены(Вход.Товары, КонецДня(Вход.Дата - 1));

	НачатьТранзакцию();
	Попытка
		Для Каждого Товар Из Вход.Товары Цикл
			СтараяЦена = СтарыеЦены[Товар];
			Если СтараяЦена = Неопределено Тогда
				Результат.skipped.Добавить(Новый Структура("id,reason",
					Строка(Товар.УникальныйИдентификатор()), "no_price"));
				Продолжить;
			КонецЕсли;
			Цена = НоваяЦена(СтараяЦена, Вход.Процент);
			ЗаписатьЦену(Товар, Вход.Дата, Цена);
			Результат.repriced.Добавить(Новый Структура("id,oldPrice,newPrice",
				Строка(Товар.УникальныйИдентификатор()), СтараяЦена, Цена));
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Соответствие товар -> цена из среза последних на момент Момент.
Функция СтарыеЦены(Товары, Момент)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений._ДемоЦеныНоменклатуры.СрезПоследних(&Момент, Номенклатура В (&Товары)) КАК Цены");
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Товары", Товары);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьЦену(Товар, Период, Цена)
	Набор = РегистрыСведений._ДемоЦеныНоменклатуры.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.Номенклатура.Установить(Товар);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.Номенклатура = Товар;
	Запись.Цена = Цена;
	Набор.Записать();
КонецПроцедуры

Функция Отказ(Статус, Код, Текст)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Неопределено, Текст);
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

// Повторяет ОтветJSON модуля HTTP-сервиса: та функция не экспортная, а модуль сервиса не меняем.
Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

#КонецОбласти
