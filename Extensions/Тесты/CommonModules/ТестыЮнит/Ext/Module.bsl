// Юнит-тесты переоценки: функция расчета без обращения к базе.
// Дизайн: docs/superpowers/specs/2026-11-10-repricing-design.md

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.Тег("Юнит")
		.ДобавитьТестовыйНабор("Общий модуль СчетаМагазинаПереоценка. НоваяЦена()")
			.ДобавитьСерверныйТест("НоваяЦена_ПроцентВверх", "НоваяЦена(). Процент вверх");

КонецПроцедуры

Процедура НоваяЦена_ПроцентВверх() Экспорт
	ЮТест.ОжидаетЧто(СчетаМагазинаПереоценка.НоваяЦена(200, 7), "200 + 7 %").Равно(214);
КонецПроцедуры
