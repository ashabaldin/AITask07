// Юнит-тесты переоценки: функция расчета без обращения к базе.
// Дизайн: docs/superpowers/specs/2026-11-10-repricing-design.md

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.Тег("Юнит")
		.ДобавитьТестовыйНабор("Общий модуль СчетаМагазинаПереоценка. НоваяЦена()")
			.ДобавитьСерверныйТест("НоваяЦена_ПроцентВверх", "НоваяЦена(). Процент вверх")
			.ДобавитьСерверныйТест("НоваяЦена_ПроцентВнизСОкруглением", "НоваяЦена(). Процент вниз с округлением до рубля")
			.ДобавитьСерверныйТест("НоваяЦена_ПоловинаВверх", "НоваяЦена(). Половина рубля вверх");

КонецПроцедуры

Процедура НоваяЦена_ПроцентВнизСОкруглением() Экспорт
	ЮТест.ОжидаетЧто(СчетаМагазинаПереоценка.НоваяЦена(99, -30), "99 - 30 % = 69,3").Равно(69);
КонецПроцедуры

Процедура НоваяЦена_ПроцентВверх() Экспорт
	ЮТест.ОжидаетЧто(СчетаМагазинаПереоценка.НоваяЦена(200, 7), "200 + 7 %").Равно(214);
КонецПроцедуры

Процедура НоваяЦена_ПоловинаВверх() Экспорт
	ЮТест.ОжидаетЧто(СчетаМагазинаПереоценка.НоваяЦена(150, 7), "150 + 7 % = 160,5").Равно(161);
КонецПроцедуры
