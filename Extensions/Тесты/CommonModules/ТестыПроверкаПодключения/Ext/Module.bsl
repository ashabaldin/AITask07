// Проверка подключения YAxUnit: один тест проходит, второй падает намеренно.
// Источник API: https://github.com/bia-technologies/yaxunit/tree/25.12/exts/yaxunit/src

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.Тег("Юнит")
		.ДобавитьТестовыйНабор("Проверка подключения YAxUnit")
			.ДобавитьСерверныйТест("Сложение_Проходит", "Сложение. 2 + 2 = 4 (проходит)")
			.ДобавитьСерверныйТест("Сложение_Падает", "Сложение. 2 + 2 = 5 (падает намеренно)");

КонецПроцедуры

Процедура Сложение_Проходит() Экспорт
	ЮТест.ОжидаетЧто(2 + 2, "Сумма 2 + 2").Равно(4);
КонецПроцедуры

Процедура Сложение_Падает() Экспорт
	ЮТест.ОжидаетЧто(2 + 2, "Сумма 2 + 2").Равно(5);
КонецПроцедуры
