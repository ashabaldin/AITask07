// Интеграционные тесты переоценки: вызов общего модуля сервиса с заглушкой HTTP-запроса YAxUnit.
// Дизайн: docs/superpowers/specs/2026-11-10-repricing-design.md
// API YAxUnit 25.12: https://github.com/bia-technologies/yaxunit/tree/25.12/exts/yaxunit/src

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.Тег("Интеграция")
		.УдалениеТестовыхДанных()
		.ДобавитьТестовыйНабор("Общий модуль СчетаМагазинаПереоценка. Переоценить()")
			.ДобавитьСерверныйТест("Переоценить_НоваяЦенаСНачалаДня", "Переоценить(). Новая цена с начала дня, старая в истории");

КонецПроцедуры

Процедура Переоценить_НоваяЦенаСНачалаДня() Экспорт

	Товар = НовыйТовар();
	ЗаписатьЦену(Товар, Дата(2025, 11, 15, 10, 0, 0), 150);
	ЗарегистрироватьКУдалению(Товар, Дата(2025, 12, 1));

	Ответ = СчетаМагазинаПереоценка.Переоценить(ЗапросПереоценки(ЮТКоллекции.ЗначениеВМассиве(Ид(Товар)), 7, "2025-12-01"));
	Тело = ТелоОтвета(Ответ);

	ЮТест.ОжидаетЧто(Ответ.КодСостояния).Равно(200);
	ЮТест.ОжидаетЧто(Тело)
		.Свойство("repriced[0].id").Равно(Ид(Товар))
		.Свойство("repriced[0].oldPrice").Равно(150)
		.Свойство("repriced[0].newPrice").Равно(161)
		.Свойство("skipped").ИмеетДлину(0);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений._ДемоЦеныНоменклатуры")
		.СодержитЗаписи(ЮТест.Предикат()
			.Реквизит("Номенклатура").Равно(Товар)
			.Реквизит("Период").Равно(Дата(2025, 12, 1))
			.Реквизит("Цена").Равно(161))
		.СодержитЗаписи(ЮТест.Предикат()
			.Реквизит("Номенклатура").Равно(Товар)
			.Реквизит("Период").Равно(Дата(2025, 11, 15, 10, 0, 0))
			.Реквизит("Цена").Равно(150));

КонецПроцедуры

#Область Хелперы

Функция ЗапросПереоценки(Товары, Процент, Дата)
	Тело = Новый Структура("items,percent,date", Товары, Процент, Дата);
	Возврат ЮТест.Данные().HTTPСервисЗапрос()
		.Метод("POST")
		.ОтносительныйURL("/prices/reprice")
		.УстановитьТелоКакСтрокуJSON(Тело);
КонецФункции

Функция ТелоОтвета(Ответ)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Тело = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Тело;
КонецФункции

// Товар создается в режиме загрузки: ПриЗаписи справочника не пишет автоматическую цену 0.
Функция НовыйТовар()
	Возврат ЮТест.Данные().КонструкторОбъекта("Справочники._ДемоНоменклатура")
		.ФикцияОбязательныхПолей()
		.Записать(, Истина);
КонецФункции

Процедура ЗаписатьЦену(Товар, Период, Цена)
	ЮТест.Данные().КонструкторОбъекта("РегистрыСведений._ДемоЦеныНоменклатуры")
		.Установить("Период", Период)
		.Установить("Номенклатура", Товар)
		.Установить("Цена", Цена)
		.Записать();
КонецПроцедуры

// Запись, которую создает проверяемый код, конструктор не видит: регистрируем ключ до утверждений.
Процедура ЗарегистрироватьКУдалению(Товар, Период)
	Ключ = РегистрыСведений._ДемоЦеныНоменклатуры.СоздатьКлючЗаписи(
		Новый Структура("Период, Номенклатура", Период, Товар));
	ЮТест.Данные().ДобавитьКУдалению(Ключ);
КонецПроцедуры

Функция Ид(Товар)
	Возврат Строка(Товар.УникальныйИдентификатор());
КонецФункции

#КонецОбласти
